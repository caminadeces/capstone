# Spring Boot authentication API. Expected POST /api/auth/login and /api/auth/register.
VITE_AUTH_API_URL=http://localhost:2222
# Python meal-planning API (py-ai-chat defaults to http://localhost:5000).
# Expected POST /api/chat with { message, history }.
VITE_MEAL_API_URL=http://localhost:5000
# Mongo-backed weekly meal plan service.
VITE_MEAL_PLAN_API_URL=http://127.0.0.1:4102
# Optional API endpoint returning the signed or public URL of the user's meal plan PDF.
VITE_MEAL_PLAN_PDF_URL=
