OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_TEMPERATURE=0.7
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=low
# Meal-plan CRUD, DynamoDB persistence, and PDF-to-S3 service.
MEAL_PLAN_SERVICE_URL=http://127.0.0.1:4102
MEAL_PLAN_INTERNAL_TOKEN=replace-with-the-same-random-secret-in-both-services
# Allow browser API requests from local Vite.
CORS_ALLOWED_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/mowm
MONGO_DB_NAME=mowm
MONGO_CHAT_COLLECTION=chat_conversations
CHAT_RATE_LIMIT=10 per minute
CHAT_DAILY_RATE_LIMIT=100 per day
RATELIMIT_STORAGE_URI=memory://
