PORT=4102
HOST=127.0.0.1
AWS_REGION=us-east-1
# If your network inspects HTTPS, get its trusted CA certificate in PEM format from IT.
# Relative paths are resolved from this project directory.
# AWS_CA_BUNDLE=C:/path/to/company-root-ca.pem
# Or trust certificates installed in the Windows/macOS system trust store.
AWS_USE_SYSTEM_CA=true
DYNAMODB_TABLE=mowm-meal-plans
S3_BUCKET=mowm-pdf-bucket
S3_PREFIX=meal-plan-pdfs
PRESIGNED_URL_TTL=3600
# Set the same random secret in py-ai-chat/.env and node-meal-plan-service/.env.
MEAL_PLAN_INTERNAL_TOKEN=replace-with-the-same-random-secret-in-both-services
# Comma-separated exact browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
# Optional source settings for one-time migration of existing plans from MongoDB.
LEGACY_MONGODB_URI=mongodb://127.0.0.1:27017/mowm
LEGACY_MONGO_DB_NAME=mowm
LEGACY_MONGO_COLLECTION=mealplans
